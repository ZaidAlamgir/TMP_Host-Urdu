---
layout: none
permalink: /news-sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {% for post in site.posts %}
      <url>
        <loc>{{ post.url | absolute_url }}</loc>
        <news:news>
          <news:publication>
            <news:name>The Urdu Post | TMP News</news:name>
            <news:language>ur</news:language>
          </news:publication>
          <news:publication_date>{{ post.date | date_to_xmlschema }}</news:publication_date>
          <news:title>{{ post.title | strip_html | escape }}</news:title>
          {% if post.tags %}<news:keywords>{{ post.tags | join: ', ' }}</news:keywords>{% endif %}
        </news:news>
      </url>
  {% endfor %}
</urlset>
